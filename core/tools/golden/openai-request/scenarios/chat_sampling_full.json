{
  "name": "chat_sampling_full",
  "kind": "openai",
  "providerName": "OpenAI",
  "config": {
    "modelId": "gpt-4.1",
    "temperature": 0.7,
    "topP": 0.95,
    "frequencyPenalty": 0.25,
    "presencePenalty": -0.5,
    "maxTokens": 2048,
    "openAiServiceTier": "priority",
    "promptCacheKey": "conv-42",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Get the weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": { "type": "string", "description": "City name" },
              "days": { "type": "array", "description": "Forecast days", "items": { "type": "integer", "description": "One day" } }
            },
            "required": ["city"]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "mcp_lookup",
          "description": "MCP-provided lookup.",
          "parameters": {
            "type": "object",
            "properties": { "q": { "type": "string", "description": "Query" } },
            "required": [],
            "schema": {
              "type": "object",
              "properties": {
                "nested": {
                  "type": "object",
                  "properties": {
                    "x": { "enum": [1, 2.5, "three", true, null] }
                  },
                  "additionalProperties": false
                }
              },
              "$defs": { "num": { "type": "number" } },
              "required": ["nested"]
            }
          }
        }
      }
    ]
  },
  "requestInput": {
    "systemPrompt": "Be precise.",
    "messages": [
      { "id": "user_1", "participant": "USER", "text": "Weather in Paris?" }
    ]
  }
}
