body|{"model":"gpt-4.1","messages":[{"role":"system","content":[{"type":"text","text":"Be precise."}]},{"role":"user","content":[{"type":"text","text":"Weather in Paris?"}]}],"stream":true,"stream_options":{"include_usage":true},"tools":[{"type":"function","function":{"name":"get_weather","description":"Get the weather for a city.","parameters":{"type":"object","properties":{"city":{"type":"string","description":"City name"},"days":{"type":"array","description":"Forecast days","items":{"type":"integer","description":"One day"}}},"required":["city"]}}},{"type":"function","function":{"name":"mcp_lookup","description":"MCP-provided lookup.","parameters":{"type":"object","properties":{"nested":{"type":"object","properties":{"x":{"enum":[1,2.5,"three",true,null]}},"additionalProperties":false}},"$defs":{"num":{"type":"number"}},"required":["nested"]}}}],"reasoning_effort":"medium","service_tier":"priority","temperature":0.7,"max_tokens":2048,"top_p":0.95,"frequency_penalty":0.25,"presence_penalty":-0.5,"prompt_cache_key":"conv-42"}
