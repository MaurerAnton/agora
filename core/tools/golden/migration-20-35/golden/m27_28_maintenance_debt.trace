result|[["execSQL","CREATE TABLE IF NOT EXISTS maintenance_debt (\\n    kind TEXT NOT NULL,\\n    identity TEXT NOT NULL,\\n    state TEXT NOT NULL,\\n    revision INTEGER NOT NULL,\\n    updatedAt INTEGER NOT NULL,\\n    claimId TEXT,\\n    claimedAt INTEGER,\\n    PRIMARY KEY(kind, identity)\\n)"],["execSQL","CREATE INDEX IF NOT EXISTS index_maintenance_debt_state_updatedAt_kind_identity\\nON maintenance_debt (state, updatedAt, kind, identity)"],["execSQL","INSERT OR IGNORE INTO maintenance_debt (\\n    kind, identity, state, revision, updatedAt, claimId, claimedAt\\n) VALUES ('ATTACHMENT_ORPHANS', '*', 'PENDING', 1, 0, NULL, NULL)"],["execSQL","INSERT OR IGNORE INTO maintenance_debt (\\n    kind, identity, state, revision, updatedAt, claimId, claimedAt\\n) VALUES ('EMBEDDING_ORPHANS', '*', 'PENDING', 1, 0, NULL, NULL)"],["execSQL","INSERT OR IGNORE INTO maintenance_debt (\\n    kind, identity, state, revision, updatedAt, claimId, claimedAt\\n) VALUES ('RUN_BRANCHES', '*', 'PENDING', 1, 0, NULL, NULL)"]]|-
