{
  "name": "chat_model_thoughts_not_forwarded",
  "kind": "openai",
  "providerName": "OpenAI",
  "config": {
    "modelId": "gpt-4.1",
    "includeAssistantReasoning": true
  },
  "requestInput": {
    "messages": [
      { "id": "user_1", "participant": "USER", "text": "hi" },
      {
        "id": "model_1",
        "participant": "MODEL",
        "text": "Hello.",
        "segments": [
          { "type": "thought", "content": "A private thought." }
        ]
      },
      { "id": "model_2", "participant": "ERROR", "text": "Something failed." },
      { "id": "user_2", "participant": "USER", "text": "continue" }
    ]
  }
}
