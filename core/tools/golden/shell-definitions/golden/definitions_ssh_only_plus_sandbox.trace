name|definitions_ssh_only_plus_sandbox
mode|definitions
count|7
tool|{"type":"function","function":{"name":"list_shells","description":"List configured shell servers including the local sandbox (if enabled).","parameters":{"type":"object","properties":{},"required":[]}}}
tool|{"type":"function","function":{"name":"execute_shell_command","description":"Execute a shell command with a 64KB UTF-8 command limit, a 32KB UTF-8 workdir limit, and at most 1MB of retained foreground output. Set background=true for a durable Conch job that survives client disconnects.","parameters":{"type":"object","properties":{"command":{"type":"string","description":"The shell command to execute (64KB UTF-8 maximum)."},"server":{"type":"string","description":"The shell server name. Use list_shells to see available servers: Local Sandbox, \\"edge\\"."},"timeout_ms":{"type":"integer","description":"Required. Foreground wait budget in milliseconds (hard ceiling 295000ms inside the tool call). On Conch, a command still running at that point continues as the same durable job and returns its job_id\s it is never killed or restarted. With background=true this instead bounds the durable job's runtime (up to Conch policy)."},"workdir":{"type":"string","description":"Working directory (optional, 32KB UTF-8 maximum)."},"background":{"type":"boolean","description":"Start a durable background job on Conch and return its job_id immediately (optional, default false)."}},"required":["command","server","timeout_ms"]}}}
tool|{"type":"function","function":{"name":"file_read","description":"Read a bounded file slice from a shell server or local sandbox. Returns valid JSON with content, line and byte counts, offset, limit, and an explicit truncated flag.","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Absolute path to the file."},"server":{"type":"string","description":"The shell server name. Available: Local Sandbox, \\"edge\\"."},"offset":{"type":"integer","description":"Byte offset (optional)."},"limit":{"type":"integer","description":"Max bytes to read (optional, default and maximum 1MB)."}},"required":["path","server"]}}}
tool|{"type":"function","function":{"name":"file_write","description":"Write up to 1MB of UTF-8 content to a file on a shell server or local sandbox.","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Absolute path to the file."},"content":{"type":"string","description":"Content to write (1MB UTF-8 maximum)."},"server":{"type":"string","description":"The shell server name. Available: Local Sandbox, \\"edge\\"."}},"required":["path","content","server"]}}}
tool|{"type":"function","function":{"name":"file_edit","description":"Edit a file on a shell server or local sandbox by replacing old_string with new_string.","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Absolute path to the file."},"old_string":{"type":"string","description":"The exact text to find and replace. LF and CRLF line endings are treated as equivalent."},"new_string":{"type":"string","description":"The replacement text. Line endings follow the matched text or target file."},"server":{"type":"string","description":"The shell server name. Available: Local Sandbox, \\"edge\\"."},"replace_all":{"type":"boolean","description":"Replace all occurrences (optional, default false)."}},"required":["path","old_string","new_string","server"]}}}
tool|{"type":"function","function":{"name":"file_glob","description":"List up to 1000 files on a shell server or local sandbox matching a glob pattern. Returns an explicit truncated flag.","parameters":{"type":"object","properties":{"pattern":{"type":"string","description":"Glob pattern matched against file names (e.g. '*.go', '*.md')."},"server":{"type":"string","description":"The shell server name. Available: Local Sandbox, \\"edge\\"."},"path":{"type":"string","description":"Base directory for the search (optional)."},"depth":{"type":"integer","description":"Max directory levels to search below 'path': 1 = base directory only, higher values recurse deeper, 0 = unlimited recursion. Omit for the server default."}},"required":["pattern","server"]}}}
tool|{"type":"function","function":{"name":"file_grep","description":"Search for up to 500 regex matches in files on a shell server or local sandbox. Returns an explicit truncated flag.","parameters":{"type":"object","properties":{"pattern":{"type":"string","description":"Regular expression pattern to search for."},"server":{"type":"string","description":"The shell server name. Available: Local Sandbox, \\"edge\\"."},"path":{"type":"string","description":"File or directory to search in (optional)."},"glob":{"type":"string","description":"Filter files by glob pattern (optional)."}},"required":["pattern","server"]}}}
